# ==============================================================================
# Kaushal Setu - Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit '.env.local' or any file containing real keys or secrets.
# - Do NOT put real secrets in this template file.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database & Authentication - to be configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Engine / Gemini API (Competency gap analysis & quiz generation - to be configured)
GEMINI_API_KEY=

# iGOT Karmayogi Ecosystem Integration (to be configured)
IGOT_KARMAYOGI_API_URL=
IGOT_KARMAYOGI_CLIENT_ID=
IGOT_KARMAYOGI_CLIENT_SECRET=
